<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.rtl8723bs-driver"
		name="RTL8723BS Driver Selector"
		version="1.0"
		provider-name="s7a7ic">
	<requires>
		<import addon="xbmc.python" version="3.0.0"/>
	</requires>
	<extension point="xbmc.python.script" library="default.py">
		<provides></provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<summary>WiFi driver selector for the Realtek RTL8723BS</summary>
		<description>This Addon includes WiFi drivers for the Realtek RTL8723BS and gives the possibility to select which kernel module to use.</description>
		<disclaimer> </disclaimer>
		<platform>all</platform>
		<news>
v1.0.0
- initial release
		</news>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.png</fanart>
		</assets>
	</extension>
</addon>
