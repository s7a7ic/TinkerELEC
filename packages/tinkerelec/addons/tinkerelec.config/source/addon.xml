<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.tinkerelec.config"
       name="TinkerELEC Config"
       version="1.0"
       provider-name="s7a7ic">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.python.script" library="default.py">
    <provides></provides>
  </extension>
  <extension point="xbmc.service" library="service.py">
    <provides></provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>TinkerELEC system configuration</summary>
    <description>This package configures LibreELEC for my specific use-case and is able to install, update or remove the patched DTB file for the NesPi+ Case.</description>
    <disclaimer />
    <platform>all</platform>
    <news>v1.0.1
- integrated DTB installer
- open settings as default action
    </news>
    <assets>
      <icon>resources/icon.png</icon>
      <fanart>resources/fanart.png</fanart>
    </assets>
  </extension>
</addon>
