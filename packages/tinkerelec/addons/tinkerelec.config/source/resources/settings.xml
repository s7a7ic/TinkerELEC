<?xml version="1.0" ?>
<settings version="1">
  <section id="script.tinkerelec.config">
    <category id="tinkerelec" label="30000" help="">
      <group id="1">
        <setting id="curl_url" type="string" label="30001" help="">
          <level>0</level>
          <default>https://my-curl-url:1880</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30002</heading>
          </control>
        </setting>
        <setting id="ping_host" type="string" label="30002" help="">
          <level>0</level>
          <default>192.168.0.1</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30003</heading>
          </control>
        </setting>
        <setting id="wake_hour" type="integer" label="30003" help="">
          <level>0</level>
          <default>8</default>
          <constraints>
            <minimum>0</minimum>
            <step>1</step>
            <maximum>23</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="wake_minute" type="integer" label="30004" help="">
          <level>0</level>
          <default>0</default>
          <constraints>
            <minimum>0</minimum>
            <step>5</step>
            <maximum>60</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="inhibit_seconds" type="integer" label="30005" help="30006">
          <level>0</level>
          <default>240</default>
          <constraints>
            <minimum>30</minimum>
            <step>10</step>
            <maximum>600</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="shell_history" type="boolean" label="30007" help="">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
  </section>
</settings>
