<?xml version="1.0" ?>
<settings version="1">
  <section id="script.tinkerelec.config">
    <category id="tinkerelec" label="30200" help="">
      <group id="1">
        <setting id="config_install" type="action" label="30004" help="">
          <level>0</level>
          <data>RunScript($ID,config)</data>
          <control type="button" format="action"/>
        </setting>
        <setting id="nespi_dtb_install" type="action" label="30006" help="">
          <level>0</level>
          <data>RunScript($ID,nespi)</data>
          <control type="button" format="action"/>
        </setting>
      </group>
      <group id="2" label="30000">
        <setting id="curl_url" type="string" label="30001" help="30101">
          <level>0</level>
          <default>https://my-curl-url:1880</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="string">
            <heading>30001</heading>
          </control>
        </setting>
        <setting id="ping_host" type="string" label="30002" help="30102">
          <level>0</level>
          <default>192.168.0.1</default>
          <constraints>
            <allowempty>false</allowempty>
          </constraints>
          <control type="edit" format="ip">
            <heading>30002</heading>
          </control>
        </setting>
        <setting id="wake_time" type="time" label="30003" help="30103">
          <level>0</level>
          <default>08:00</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
        <setting id="inhibit_seconds" type="integer" label="30005" help="30105">
          <level>0</level>
          <default>240</default>
          <constraints>
            <minimum>30</minimum>
            <step>10</step>
            <maximum>600</maximum>
          </constraints>
          <control type="slider" format="integer">
            <popup>false</popup>
          </control>
        </setting>
        <setting id="shell_history" type="boolean" label="30007" help="30107">
          <level>0</level>
          <default>false</default>
          <control type="toggle"/>
        </setting>
      </group>
    </category>
    <category id="prevent_idle" label="30201" help="">
      <group id="0">
        <setting id="idle_net" type="integer" label="30008" help="30108">
          <level>0</level>
          <default>1</default>
          <control type="toggle"/>
        </setting>
      </group>
      <group id="1" label="30010">
        <setting id="time_1_enabled" type="integer" label="30009" help="">
          <level>0</level>
          <default>0</default>
          <control type="toggle"/>
        </setting>
        <setting id="time_1_from" type="time" label="30013" help="">
          <level>0</level>
          <default>08:00</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
        <setting id="time_1_until" type="time" label="30014" help="">
          <level>0</level>
          <default>09:45</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
      </group>
      <group id="2" label="30011">
        <setting id="time_2_enabled" type="integer" label="30009" help="">
          <level>0</level>
          <default>0</default>
          <control type="toggle"/>
        </setting>
        <setting id="time_2_from" type="time" label="30013" help="">
          <level>0</level>
          <default>16:00</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
        <setting id="time_2_until" type="time" label="30014" help="">
          <level>0</level>
          <default>18:00</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
      </group>
      <group id="3" label="30012">
        <setting id="time_3_enabled" type="integer" label="30009" help="">
          <level>0</level>
          <default>0</default>
          <control type="toggle"/>
        </setting>
        <setting id="time_3_from" type="time" label="30013" help="">
          <level>0</level>
          <default>22:00</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
        <setting id="time_3_until" type="time" label="30014" help="">
          <level>0</level>
          <default>23:50</default>
          <control type="button" format="time">
            <heading>30003</heading>
          </control>
        </setting>
      </group>
    </category>
  </section>
</settings>
